{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentEval human failure label",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "domain",
    "annotator_id",
    "label",
    "success",
    "confidence",
    "labeled_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "description": "Trajectory.run_id being labeled"
    },
    "task_id": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "booking",
        "support",
        "coding"
      ]
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "annotator_id": {
      "type": "string",
      "pattern": "^ann_[0-9]{2}$"
    },
    "label": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "IGNORED_POLICY",
        "LOOPING",
        "GAVE_UP_EARLY",
        "WRONG_TOOL",
        "HALLUCINATED_ARG",
        "HALLUCINATED_FACT",
        "PARTIAL_SUCCESS",
        "WRONG_STATE"
      ],
      "description": "Primary (root-cause) label"
    },
    "secondary": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SUCCESS",
          "IGNORED_POLICY",
          "LOOPING",
          "GAVE_UP_EARLY",
          "WRONG_TOOL",
          "HALLUCINATED_ARG",
          "HALLUCINATED_FACT",
          "PARTIAL_SUCCESS",
          "WRONG_STATE"
        ]
      },
      "uniqueItems": true
    },
    "success": {
      "type": "boolean",
      "description": "Must equal (label == 'SUCCESS')"
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "failure_step": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Index of the first unrecovered mistake"
    },
    "notes": {
      "type": "string"
    },
    "time_spent_sec": {
      "type": "integer",
      "minimum": 0
    },
    "labeled_at": {
      "type": "string",
      "description": "ISO-8601 date"
    }
  },
  "additionalProperties": false
}
